# Copy to .env and fill in. Never commit .env.

# --- LLM ("provider:model" for langchain's init_chat_model) ---------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=openai:gpt-6-luna
WRITER_MODEL=openai:gpt-6-luna
JUDGE_MODEL=openai:gpt-6-luna
# Claude instead: AGENT_MODEL=anthropic:claude-haiku-5-5, WRITER_MODEL=anthropic:claude-opus-5-5
# json_schema = provider-native structured output; use function_calling if your provider package lacks it
STRUCTURED_OUTPUT_METHOD=json_schema

# --- News -------------------------------------------------------------------
TAVILY_API_KEY=

# --- Langfuse (tracing, prompts, evals) --------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
APP_VERSION=v0.1
# Week 5: fetch prompts from Langfuse prompt management instead of app/prompts/
LANGFUSE_PROMPTS=false

# --- Persistence ------------------------------------------------------------------
# Empty = SQLite (checkpoints.db). docker-compose sets this to its Postgres service.
DATABASE_URL=

# --- Deployment -----------------------------------------------------------------------
# Browser origins allowed to call a hosted API, comma-separated (e.g. your Vercel URL).
CORS_ORIGINS=

# --- Ports ----------------------------------------------------------------------------
# API: uvicorn app.api.main:app --reload --port 8010    Web UI: npm run dev -> :5180
# (8000/5173 are left free for other projects)
