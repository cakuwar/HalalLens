# Leave VITE_USE_MOCK unset to auto-detect: use the FastAPI backend (through the /api
# proxy in vite.config.js) when it answers, otherwise fall back to demo mode.
#   VITE_USE_MOCK=true   always run the built-in demo agent (no backend needed)
#   VITE_USE_MOCK=false  always use the backend, and show an error if it is down
# VITE_USE_MOCK=
